{
  "name": "events-widget",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.js",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build": "npm run build:admin && npm run build:widget && cp -R dist-widget/. dist/",
    "build:admin": "vite build --config vite.admin.config.ts",
    "build:widget": "vite build --config vite.widget.config.ts",
    "preview": "vite preview",
    "keepalive:ping": "node scripts/ping-backend.mjs"
  },
  "dependencies": {
    "@sentry/react": "^10.35.0",
    "compression": "^1.8.1",
    "lucide-react": "^0.562.0",
    "preact": "^10.28.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^8.2.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
